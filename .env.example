# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored. NEVER put real secrets in this file: it is committed.

# The key clients send in the X-API-Key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=change-me

# Where the UI's server code calls the API. Defaults to http://localhost:3000,
# or https://$VERCEL_URL on Vercel.
# API_BASE_URL=http://localhost:3000

# Time zone used to display slot times (IANA name, e.g. Africa/Lagos, Europe/London).
CLINIC_TIME_ZONE=UTC

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Server-only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=clinic
